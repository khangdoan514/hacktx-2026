{
  "$schema": "https://opencode.ai/config.json",
  // Phase 2 execution policy. OpenCode enforces this file; the Go service
  // only validates schemas and records history. Last matching rule wins.
  // Base policy allows everything, so this file starts with deny-all and
  // then names the only exceptions.
  "model": "meta/muse-spark-1.3-contributor",
  "default_agent": "vendor-orchestrator",
  "share": "disabled",
  "snapshots": false,
  "formatter": false,
  "lsp": false,
  "experimental": {
    // Depth 1: a primary agent may launch a subagent, and that subagent
    // cannot launch another. This is the harness backstop for the depth rule.
    "subagent_depth": 1
  },
  "watcher": {
    "ignore": [".env", ".env.*", "**/.env", "**/.env.*"]
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "deny" },
    { "action": "catalog_*", "resource": "*", "effect": "deny" },
    { "action": "tools_*", "resource": "*", "effect": "deny" },
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "opencode_list_mcp_resources", "resource": "*", "effect": "deny" },
    { "action": "opencode_read_mcp_resource", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "catalog": {
        "type": "local",
        "command": ["go", "run", "./cmd/catalog-mcp"],
        "codemode": false,
        "timeout": { "startup": 60000, "catalog": 15000, "execution": 10000 }
      },
      // Built-in GitHub and Google Drive packs (agents/internal/toolpacks).
      // Credentials come from the console's Tools page, not from this file.
      "tools": {
        "type": "local",
        "command": ["go", "run", "./cmd/tools-mcp"],
        "codemode": false,
        "timeout": { "startup": 60000, "tools": 30000, "execution": 30000 }
      }
    }
  },
  "agents": {
    "vendor-orchestrator": {
      "description": "Vendor comparison orchestrator",
      "mode": "primary",
      "steps": 8,
      "system": "You are Vendor comparison orchestrator (orchestrator). Use only authorized actions and cite fictional source IDs.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "catalog-specialist", "effect": "allow" },
        { "action": "subagent", "resource": "accessibility-specialist", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" }
      ]
    },
    "denial-orchestrator": {
      "description": "Depth denial demonstration",
      "mode": "primary",
      "steps": 8,
      "system": "You are Depth denial demonstration (orchestrator). Use only authorized actions and cite fictional source IDs.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "denial-specialist", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" }
      ]
    },
    "catalog-specialist": {
      "description": "Catalog specialist",
      "mode": "subagent",
      "steps": 8,
      "system": "You are Catalog specialist (specialist). Use only authorized actions and cite fictional source IDs.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "fixtures/catalog/*", "effect": "deny" },
        { "action": "read", "resource": "*/fixtures/catalog/*", "effect": "deny" },
        { "action": "catalog_*", "resource": "*", "effect": "deny" },
        { "action": "catalog_search", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "opencode_list_mcp_resources", "resource": "*", "effect": "deny" },
        { "action": "opencode_read_mcp_resource", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "deny" }
      ]
    },
    "accessibility-specialist": {
      "description": "Accessibility specialist",
      "mode": "subagent",
      "steps": 8,
      "system": "You are Accessibility specialist (specialist). Use only authorized actions and cite fictional source IDs.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "fixtures/catalog/*", "effect": "deny" },
        { "action": "read", "resource": "*/fixtures/catalog/*", "effect": "deny" },
        { "action": "catalog_*", "resource": "*", "effect": "deny" },
        { "action": "catalog_search", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "opencode_list_mcp_resources", "resource": "*", "effect": "deny" },
        { "action": "opencode_read_mcp_resource", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "deny" }
      ]
    },
    // The definition lists catalog-specialist as a delegate. That request is
    // the depth-escalation case: a specialist still cannot launch anyone.
    "denial-specialist": {
      "description": "Depth denial specialist",
      "mode": "subagent",
      "steps": 8,
      "system": "You are Depth denial specialist (specialist). Use only authorized actions and cite fictional source IDs.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "catalog-specialist", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" }
      ]
    },
    // Free-form chat (the console's Threads page). No pre-compiled prompt.
    // Read-only tools run directly; shell and edits require an explicit
    // per-call decision in the Threads UI.
    "builder-agent": {
      "description": "Model-only agent published from the website",
      "mode": "primary",
      "steps": 12,
      "system": "Follow the published agent instructions supplied in the prompt. Complete the task using only the provided input. Do not call tools or delegate.",
      "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }]
    },
    "thread": {
      "description": "Open-ended thread",
      "mode": "primary",
      "steps": 20,
      "system": "You are a helpful agent. Use tools when they help complete the user's request. Uploaded files are included in the message or as native attachments; they are not workspace paths. Analyze their provided content directly. Ask for approval through the tool permission mechanism when an operation requires it. Explain meaningful results naturally; do not add tool-use footers.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "ask" },
        { "action": "catalog_*", "resource": "*", "effect": "deny" },
        { "action": "catalog_search", "resource": "*", "effect": "allow" },
        { "action": "tools_*", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "deny" }
      ]
    },
    "workspace-assistant": {
      "description": "Workspace assistant",
      "mode": "primary",
      "steps": 12,
      "system": "You are Workspace assistant (orchestrator). Use only authorized actions and cite the url of every source.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "tools_github_search_repositories", "resource": "*", "effect": "allow" },
        { "action": "tools_github_search_code", "resource": "*", "effect": "allow" },
        { "action": "tools_github_get_file", "resource": "*", "effect": "allow" },
        { "action": "tools_github_list_issues", "resource": "*", "effect": "allow" },
        { "action": "tools_github_get_issue", "resource": "*", "effect": "allow" },
        { "action": "tools_github_list_pull_requests", "resource": "*", "effect": "allow" },
        { "action": "tools_gdrive_search_files", "resource": "*", "effect": "allow" },
        { "action": "tools_gdrive_list_folder", "resource": "*", "effect": "allow" },
        { "action": "tools_gdrive_read_file", "resource": "*", "effect": "allow" }
      ]
    },
    "build": {
      "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }]
    },
    "plan": {
      "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }]
    },
    "general": {
      "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }]
    },
    "explore": {
      "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }]
    },
    "compaction": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
