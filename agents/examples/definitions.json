  {
    "id": "workspace-assistant",
    "version": "1.2.0",
    "name": "Workspace assistant",
    "role": "orchestrator",
    "instructions": "Answer questions about the user's GitHub repositories, Google Drive documents, shared Notion pages, and public Slack conversations using only the read-only tools you are given. Cite the url of every source. If a tool says it is not connected, report that and stop.",
    "input_schema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "answer",
        "sources"
      ],
      "additionalProperties": false
    },
    "allowed_tools": [
      "github.search_repositories",
      "github.search_code",
      "github.get_file",
      "github.list_issues",
      "github.get_issue",
      "github.list_pull_requests",
      "gdrive.search_files",
      "gdrive.list_folder",
      "gdrive.read_file",
      "notion.search",
      "notion.get_page",
      "notion.list_blocks",
      "notion.get_database",
      "notion.query_data_source",
      "slack.search_messages",
      "slack.list_channels",
      "slack.get_channel_history",
      "slack.get_thread",
      "slack.get_permalink"
    ],
    "allowed_delegates": [],
    "limits": {
      "max_delegations": 1,
      "max_concurrent_agents": 1,
      "max_tool_calls": 10,
      "max_model_turns": 12,
      "max_tokens": 20000,
      "max_cost_usd": 2,
      "timeout_seconds": 120
    }
  }
