[
  {
    "id": "vendor-orchestrator",
    "version": "1.0.0",
    "name": "Vendor comparison orchestrator",
    "role": "orchestrator",
    "instructions": "Compare vendors using only catalog/vendors.json. Delegate the lookup and the price score, then recommend one vendor id from that file.",
    "input_schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget_usd": {
          "type": "number"
        }
      },
      "required": [
        "task"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "recommendation": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specialist_results": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "recommendation",
        "source_ids",
        "specialist_results"
      ],
      "additionalProperties": false
    },
    "allowed_tools": [],
    "allowed_delegates": [
      "catalog-specialist",
      "pricing-specialist"
    ],
    "limits": {
      "max_delegations": 2,
      "max_concurrent_agents": 2,
      "max_tool_calls": 4,
      "max_model_turns": 8,
      "max_tokens": 12000,
      "max_cost_usd": 2,
      "timeout_seconds": 60
    }
  },
