# Local disposable environment for the agent service.
# Copy these names into a gitignored file or a shell you control.
# Leave every secret blank in git. This file is not a production configuration
# and contains no credentials, project refs, or measured service targets.

# Listen address. The service defaults to 127.0.0.1:8080.
NMC3_ADDR=127.0.0.1:8080

# Set to postgres to use DATABASE_URL. Any other value selects the Supabase
# Data API. Point either setting at a disposable database only.
NMC3_STORE=postgres
DATABASE_URL=

# Used only when NMC3_STORE is not postgres.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

NMC3_DEFINITIONS_FILE=examples/definitions.json

# Local OpenCode process. Password resolution prefers OPENCODE_SERVICE_PASSWORD,
# then OPENCODE_SERVICE_FILE, then ~/.config/opencode/service.json.
OPENCODE_URL=http://127.0.0.1:49374
OPENCODE_SERVICE_PASSWORD=
OPENCODE_SERVICE_FILE=
OPENCODE_MODEL=
NMC3_WORKDIR=
