SUPABASE_URL=https://vocvwmiypifqnncxhfpj.supabase.co
SUPABASE_SECRET_KEY=
# Local runs use a separate database from the business API. Leave
# SUPABASE_SECRET_KEY empty and keep NMC3_STORE=postgres unless this process
# should call the hosted Data API instead.
NMC3_STORE=postgres
DATABASE_URL=postgresql:///hacktx_nmc3_agent
# Definitions and approvals. Same database as DATABASE_URL for local runs.
# Required when NMC3_STORE is not postgres, so the business DATABASE_URL is not used.
NMC3_DATABASE_URL=postgresql:///hacktx_nmc3_agent
NMC3_ADDR=127.0.0.1:8080
# OpenCode execution backend (local service).
OPENCODE_URL=http://127.0.0.1:49374
# Service password. Prefer the default registration file
# (~/.config/opencode/service.json); set this only to override it.
OPENCODE_SERVICE_PASSWORD=
# Default model in provider/model format. Override per run from the Runs page
# with any OpenRouter ID (free OSS, GPT, or Claude). The :free roster rotates;
# confirm current IDs at https://openrouter.ai/models.
OPENCODE_MODEL=meta/muse-spark-1.3-contributor
# Session directory. OpenCode loads opencode.jsonc from here, so this must
# be the agents module (the default when the process is started there).
NMC3_WORKDIR=
