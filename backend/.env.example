# production refuses ALLOW_LOCAL_AUTH. Use local or test only for the password sign-in below.
ENVIRONMENT=production

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Postgres connection for the API process. Use a NOBYPASSRLS role in production.
DATABASE_URL=

# HS256 secret used to verify Supabase Auth access tokens. Server only.
JWT_SECRET=
JWT_ISSUER=http://127.0.0.1:54321/auth/v1
JWT_AUDIENCE=authenticated

# Local password sign-in. Ignored unless ENVIRONMENT is local or test.
ALLOW_LOCAL_AUTH=false

# Private file bytes when Supabase Storage is not configured.
STORAGE_DIR=var/storage

# Optional Convex hint delivery. Leave the HTTP URL blank to poll FastAPI instead.
# Convex verifies Supabase RS256/ES256 tokens from CONVEX_JWT_JWKS. It does not accept the local HS256 test secret.
CONVEX_URL=
CONVEX_HTTP_URL=
CONVEX_HINT_SECRET=
CONVEX_JWT_ISSUER=
CONVEX_JWT_AUDIENCE=authenticated
CONVEX_JWT_JWKS=
CONVEX_JWT_ALGORITHM=RS256

# Optional hosted Supabase project. Not required for local Postgres.
SUPABASE_URL=
