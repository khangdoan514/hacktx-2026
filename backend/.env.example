# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Postgres connection for the API process. Use a NOBYPASSRLS role in production.
DATABASE_URL=

# HS256 secret used to verify Supabase Auth access tokens. Server only.
JWT_SECRET=
JWT_ISSUER=http://127.0.0.1:54321/auth/v1
JWT_AUDIENCE=authenticated

# Local password sign-in when Supabase Auth is not running. Keep false in production.
ALLOW_LOCAL_AUTH=false

# Private file bytes when Supabase Storage is not configured.
STORAGE_DIR=var/storage

# Optional Convex deployment. Leave blank to skip live hints; the UI polls instead.
CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Optional hosted Supabase project. Not required for local Postgres.
SUPABASE_URL=
