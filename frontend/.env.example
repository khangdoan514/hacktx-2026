# Where the Next.js server proxies /api/* requests (see next.config.ts)
BACKEND_URL=http://localhost:8000

# Public Supabase browser settings. Leave blank to use the local API sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Convex URL for live hints. The product polls FastAPI when this is empty.
NEXT_PUBLIC_CONVEX_URL=
