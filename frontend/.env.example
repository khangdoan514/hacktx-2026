# Where the Next.js server proxies /api/* requests (see next.config.ts)
BACKEND_URL=http://localhost:8000

# Public Supabase browser settings. Leave blank to use the local API sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Convex subscription. Both values are required before a client subscription is used.
# Leave them empty to keep polling FastAPI.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_JWT_ISSUER=
