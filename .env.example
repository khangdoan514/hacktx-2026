ENVIRONMENT=local
DATABASE_URL=postgresql://ubuntu@/hacktx_nmc3
JWT_SECRET=replace-with-a-long-random-string
JWT_ISSUER=https://vocvwmiypifqnncxhfpj.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=https://vocvwmiypifqnncxhfpj.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://vocvwmiypifqnncxhfpj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ALLOW_LOCAL_AUTH=true
AGENT_EXECUTION_MODE=dummy
STORAGE_DIR=var/storage
ADDR=:8000
# Shared by cmd/api and the private agent process. CLI and browser callers
# do not send this. They send Authorization: Bearer to :8000/agent-api.
NMC3_INTERNAL_TOKEN=local-internal
# cmd/api on the host. Compose does not read this; the api service calls
# http://agent:8080 unless COMPOSE_AGENT_API_URL is set.
AGENT_API_URL=http://127.0.0.1:8080
# Dedicated database for agents/cmd/nmc3-agent. Do not reuse DATABASE_URL;
# that database already has a different nmc3.runs table for the business API.
AGENT_DATABASE_URL=postgresql:///hacktx_nmc3_agent
# For Docker with the host OpenCode service, set PROJECT_ROOT and NMC3_WORKDIR
# to absolute paths on the host so the OpenCode process can access the workspace.
PROJECT_ROOT=
NMC3_WORKDIR=
NMC3_TOOLS_DIR=.nmc3
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY_ID=nmc3-local
S3_SECRET_ACCESS_KEY=nmc3-local-secret
S3_BUCKET=nmc3-threads
S3_USE_SSL=false
# Used by the agent container to reach OpenCode running on the host.
OPENCODE_DOCKER_URL=http://host.docker.internal:49374
# Used when running the agent directly on the host.
OPENCODE_URL=http://127.0.0.1:49374
OPENCODE_SERVICE_PASSWORD=
# Model the Compose agent asks the host OpenCode service to run.
OPENCODE_MODEL=opencode/beam-free
