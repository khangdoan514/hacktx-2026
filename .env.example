ENVIRONMENT=local
DATABASE_URL=postgresql://ubuntu@/hacktx_nmc3
JWT_SECRET=replace-with-a-long-random-string
JWT_ISSUER=https://vocvwmiypifqnncxhfpj.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=https://vocvwmiypifqnncxhfpj.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://vocvwmiypifqnncxhfpj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ALLOW_LOCAL_AUTH=true
AGENT_EXECUTION_MODE=dummy
STORAGE_DIR=var/storage
ADDR=:8000
# Shared by cmd/api and the private agent process. CLI and browser callers
# do not send this. They send Authorization: Bearer to :8000/agent-api.
NMC3_INTERNAL_TOKEN=local-internal
AGENT_API_URL=http://127.0.0.1:8080
# GitHub App connection for repository-scoped agent runs. Keep the private key
# outside the repository and mount its path into the API container.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_CALLBACK_URL=http://localhost:3010/api/v1/github/oauth/callback
GITHUB_APP_CONSOLE_URL=http://localhost:3010
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# Separate random 32+ character secret for short-lived repository run scopes.
GITHUB_SCOPE_SIGNING_KEY=
NMC3_APP_API_URL=http://127.0.0.1:8000
# Dedicated database for agents/cmd/nmc3-agent. Do not reuse DATABASE_URL;
# that database already has a different nmc3.runs table for the business API.
AGENT_DATABASE_URL=postgresql:///hacktx_nmc3_agent
